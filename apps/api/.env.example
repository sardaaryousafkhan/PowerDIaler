NODE_ENV=development
PORT=4000

# Set to 1 for a local-only demo: no Redis worker, no Twilio (simulated calls/SMS).
# DEMO_MODE=1

# SQLite database file (relative to `apps/api/prisma/`)
DATABASE_URL=file:./dev.db

# BullMQ / Redis
REDIS_URL=redis://127.0.0.1:6379

# Public URL Twilio will call back (use an HTTPS tunnel in local dev, e.g. ngrok)
PUBLIC_BASE_URL=https://YOUR_SUBDOMAIN.ngrok-free.app
# Optional explicit canonical base URL used for webhook signature validation.
# Set this when running behind proxies/load balancers that rewrite forwarded headers.
PUBLIC_WEBHOOK_BASE_URL=https://YOUR_SUBDOMAIN.ngrok-free.app
# Set to false if your deployment should not trust x-forwarded-* headers.
TRUST_PROXY=true
# Optional CORS allowlist (comma-separated origins). Leave empty to allow all origins.
CORS_ALLOWED_ORIGINS=
# If true, allows credentialed CORS requests for allowed origins.
CORS_ALLOW_CREDENTIALS=false

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vonage — from https://dashboard.nexmo.com
# 1. API key + secret: dashboard home page.
# 2. Create a Voice-capable Application; download its private key and copy the app id.
#    Paste the private key on one line with \n in place of line breaks, e.g.
#    VONAGE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
# 3. Signature secret: Dashboard -> Settings -> "Signature secret" (enables signed webhooks).
# 4. Link a Vonage number to the application and use it as the campaign From number.
# Webhooks are set automatically per call; no dashboard webhook URLs are required for voice.
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY=
# Optional alphanumeric SMS sender (max 11 chars; not supported for US numbers —
# leave empty to send from the campaign number).
VONAGE_BRAND_NAME=
VONAGE_WEBHOOK_SIGNATURE_SECRET=

# Google Voice bridge (your adapter service that accepts /dial and /sms)
GOOGLE_VOICE_BRIDGE_BASE_URL=http://127.0.0.1:5998
GOOGLE_VOICE_BRIDGE_API_KEY=change-me-google-bridge-api-key

# RingCentral bridge (your adapter service that accepts /dial and /sms)
RINGCENTRAL_BRIDGE_BASE_URL=
RINGCENTRAL_BRIDGE_API_KEY=

# Nextiva bridge (your adapter service that accepts /dial and /sms)
NEXTIVA_BRIDGE_BASE_URL=
NEXTIVA_BRIDGE_API_KEY=

# Dialpad bridge (your adapter service that accepts /dial and /sms)
DIALPAD_BRIDGE_BASE_URL=
DIALPAD_BRIDGE_API_KEY=

# Zoom Phone bridge (services/zoom-phone-bridge — see SETUP.md)
ZOOM_PHONE_BRIDGE_BASE_URL=http://127.0.0.1:5999
ZOOM_PHONE_BRIDGE_API_KEY=change-me-bridge-api-key
BRIDGE_CALLBACK_SECRET=change-me-callback-secret-min-32-chars
ZOOM_PHONE_AGENT_USER_ID=
# DEMO_MODE=1 simulates Twilio; DEMO_MODE=bridge uses real bridge with demo queue

# Aircall bridge (your adapter service that accepts /dial and /sms)
AIRCALL_BRIDGE_BASE_URL=
AIRCALL_BRIDGE_API_KEY=

# 8x8 bridge (your adapter service that accepts /dial and /sms)
EIGHT_BY_EIGHT_BRIDGE_BASE_URL=
EIGHT_BY_EIGHT_BRIDGE_API_KEY=

# Ooma Office bridge (your adapter service that accepts /dial and /sms)
OOMA_OFFICE_BRIDGE_BASE_URL=
OOMA_OFFICE_BRIDGE_API_KEY=

# Microsoft Teams Phone bridge (your adapter service that accepts /dial and /sms)
MICROSOFT_TEAMS_PHONE_BRIDGE_BASE_URL=
MICROSOFT_TEAMS_PHONE_BRIDGE_API_KEY=

# Custom integration bridge (bring-your-own provider adapter)
CUSTOM_INTEGRATION_BRIDGE_BASE_URL=
CUSTOM_INTEGRATION_BRIDGE_API_KEY=

# CRM bridge adapters
SALESFORCE_CRM_BRIDGE_BASE_URL=
SALESFORCE_CRM_BRIDGE_API_KEY=
ZOHO_CRM_BRIDGE_BASE_URL=
ZOHO_CRM_BRIDGE_API_KEY=
HUBSPOT_CRM_BRIDGE_BASE_URL=
HUBSPOT_CRM_BRIDGE_API_KEY=
PIPEDRIVE_CRM_BRIDGE_BASE_URL=
PIPEDRIVE_CRM_BRIDGE_API_KEY=
FRESHSALES_CRM_BRIDGE_BASE_URL=
FRESHSALES_CRM_BRIDGE_API_KEY=
ZENDESK_SELL_CRM_BRIDGE_BASE_URL=
ZENDESK_SELL_CRM_BRIDGE_API_KEY=
CUSTOM_INTEGRATION_CRM_BRIDGE_BASE_URL=
CUSTOM_INTEGRATION_CRM_BRIDGE_API_KEY=

# CallHippo bridge (your adapter service that accepts /dial and /sms)
CALLHIPPO_BRIDGE_BASE_URL=
CALLHIPPO_BRIDGE_API_KEY=

# WhatsApp Cloud API (required when integration preference = whatsapp)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Auth / security
AUTH_SECRET=replace-with-a-long-random-secret
# Optional AES key for per-org integration secrets (falls back to AUTH_SECRET)
SECRETS_MASTER_KEY=
# Optional: set to allow admin registration when this code is supplied during sign-up
ADMIN_REGISTRATION_CODE=

# Google OAuth (optional — enables Continue with Google on login)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:4000/auth/google/callback
PUBLIC_WEB_URL=http://127.0.0.1:5173

# Master owner account (auto-provisioned on startup)
OWNER_EMAIL=owner@powerdialer.local
OWNER_PASSWORD=OwnerChangeMe123!
OWNER_NAME=Master Owner

# Used when CSV numbers are missing a country code
DEFAULT_PHONE_REGION=US

# Delay between queued SMS jobs (milliseconds)
SMS_DELAY_MS=750

# Do not re-send the same SMS text to the same number within this many days (0 = off)
SMS_DEDUP_DAYS=15
