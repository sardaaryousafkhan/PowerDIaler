PORT=5999
BRIDGE_API_KEY=change-me-bridge-api-key
BRIDGE_CALLBACK_SECRET=change-me-callback-secret-min-32-chars
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=
ZOOM_DEFAULT_USER_ID=
ZOOM_PHONE_CALLER_ID=+12025550102
PUBLIC_BRIDGE_URL=http://127.0.0.1:5999
POWER_DIALER_PUBLIC_URL=http://127.0.0.1:4000
# DATABASE_URL is resolved relative to prisma/schema.prisma, so the SQLite
# file lives at services/zoom-phone-bridge/prisma/bridge.db (NOT the service root).
DATABASE_URL=file:./bridge.db
# mock = simulated calls for local demo; api = real Zoom OAuth + webhooks
ZOOM_BRIDGE_MODE=mock
