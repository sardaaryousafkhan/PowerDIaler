# Copy to .env on the server (keep outside public web root if your host allows).
# If .env must sit next to PHP, protect it with .htaccess (already included).

DD_DB_HOST=localhost
DD_DB_NAME=your_cpanel_db_name
DD_DB_USER=your_cpanel_db_user
DD_DB_PASS=your_db_password

# REQUIRED. Long random string (16+ chars, use 40+) used when hashing license keys.
# The service refuses to run with a short or placeholder value.
# Generate one: open https://derivedstudio.com/license/admin/ once; or in Terminal: openssl rand -hex 32
# NEVER change this after issuing keys — existing keys would stop validating.
DD_KEY_PEPPER=change-me-to-a-long-random-secret

# Admin login for /license/admin/
DD_ADMIN_USER=owner
# Option A (simplest): plain password, must be 12+ characters.
DD_ADMIN_PASS=change-this-password-12chars
# Option B (safer): a password hash instead of the plain password. Generate with:
#   php -r 'echo password_hash("your password", PASSWORD_DEFAULT), PHP_EOL;'
# If DD_ADMIN_PASS_HASH is set, DD_ADMIN_PASS is ignored.
DD_ADMIN_PASS_HASH=

# Optional: comma-separated IPs allowed for admin (empty = any IP with the password)
DD_ADMIN_IP_ALLOWLIST=
