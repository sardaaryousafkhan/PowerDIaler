PORT=5997
BRIDGE_API_KEY=change-me-ringcentral-bridge-api-key
BRIDGE_CALLBACK_SECRET=change-me-callback-secret-min-32-chars
POWER_DIALER_PUBLIC_URL=http://127.0.0.1:4000

# uri = open RingCentral desktop app (rcapp://); mock = fake lifecycle only; api = live RingOut/SMS
RINGCENTRAL_BRIDGE_MODE=uri

# How long (ms) to treat a URI-launched call as in-progress before COMPLETED
URI_CALL_HOLD_MS=25000

# Required when RINGCENTRAL_BRIDGE_MODE=api (JWT app credentials)
# RC_SERVER_URL=https://platform.ringcentral.com
# RC_CLIENT_ID=
# RC_CLIENT_SECRET=
# RC_JWT=
# RC_DEFAULT_FROM=+1XXXXXXXXXX
