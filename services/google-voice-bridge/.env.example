PORT=5998
BRIDGE_API_KEY=change-me-google-bridge-api-key
BRIDGE_CALLBACK_SECRET=change-me-callback-secret-min-32-chars
PUBLIC_BRIDGE_URL=http://127.0.0.1:5998
POWER_DIALER_PUBLIC_URL=http://127.0.0.1:4000
# DATABASE_URL is resolved relative to prisma/schema.prisma, so the SQLite
# file lives at services/google-voice-bridge/prisma/bridge.db (NOT the service root).
DATABASE_URL=file:./bridge.db
# mock = simulated calls/SMS; hybrid = tel:/Voice web URIs (no server dial); ccai = Contact Center API
GOOGLE_VOICE_BRIDGE_MODE=mock
CCAI_SUBDOMAIN=
CCAI_DOMAIN=
CCAI_API_TOKEN=
CCAI_DEFAULT_AGENT_EMAIL=
GOOGLE_VOICE_CALLER_ID=+12025550102
